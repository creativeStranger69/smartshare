# Copy this file to ".env" and fill it in:   cp .env.example .env     (Windows: copy .env.example .env)
# .env is git-ignored - never commit real secrets.

# --- required in production ---
# MongoDB connection. Local:  mongodb://127.0.0.1:27017/smartshare
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/smartshare
MONGO_URI=mongodb://127.0.0.1:27017/smartshare

# Secret used to sign login tokens. Production needs 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# --- optional ---
PORT=3000
# "production" turns on: Secure cookies, JSON logs, startup check that JWT_SECRET is strong
NODE_ENV=development
# Largest allowed upload in megabytes
MAX_FILE_MB=25
# Where uploaded files are stored (default: ./uploads)
# UPLOAD_DIR=/var/lib/smartshare/uploads
# Number of reverse proxies in front of the app (nginx/Caddy/Render = 1). Default: 1 in production, 0 otherwise.
# TRUST_PROXY=1
# Set to false ONLY to demo NODE_ENV=production over plain http (cookies are Secure by default in production)
# COOKIE_SECURE=false
# Extra website origins allowed to call the API (comma separated). Normally leave empty.
# ALLOWED_ORIGINS=https://chat.example.com

# --- FRAUD-LINK CHECK (optional) ---
# Free Google Safe Browsing key: https://developers.google.com/safe-browsing/v4/get-started
# Without it the built-in heuristics (look-alike domains, IP links, scam words ...) are used.
# SAFE_BROWSING_API_KEY=

# --- AUTO-TRANSLATE ---
# mymemory (default, free, no key, ~5,000 characters/day) | libretranslate (self-hosted) | google (paid) | none
TRANSLATE_PROVIDER=mymemory
# Raises the free MyMemory limit to ~50,000 characters/day:
# MYMEMORY_EMAIL=you@example.com
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=
# GOOGLE_TRANSLATE_KEY=
